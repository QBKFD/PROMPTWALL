# Copy to .env and fill in. .env is git-ignored; never commit it.

# Which LLM backend /chat calls: anthropic | ollama | fake
LLM_BACKEND=anthropic

# Anthropic (used when LLM_BACKEND=anthropic, and by the LLM judge)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# Ollama (used when LLM_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Max output tokens per LLM call
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60

# Hard spending cap, enforced per process (one server run or one eval run).
# A call is refused before it is sent if it could push usage past either cap.
BUDGET_MAX_CALLS=200
BUDGET_MAX_TOKENS=400000

# Policy file (which checks run, and block / mask / log per check)
POLICY_PATH=config/policy.yaml
